# Gradle
.gradle/
build/
bin/

# 로컬에 풀어둔 Gradle 배포판 전체는 커밋하지 않는다.
# 빌드는 backend/gradlew (Wrapper) 로만 수행한다.
/gradle/gradle-*/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Uploads & Logs
uploads/
*.log

# Env / Secrets
.env
.env.*
!.env.example

# Compiled class file
*.class
*.war

# jar 은 원칙적으로 제외하되, Gradle Wrapper jar 은 반드시 커밋해야 한다.
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar
