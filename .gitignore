# Gradle
.gradle/
build/
bin/

# 로컬에 풀어둔 Gradle 배포판 전체는 커밋하지 않는다.
# 빌드는 backend/gradlew (Wrapper) 로만 수행한다.
/gradle/gradle-*/

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local

# IDE
.idea/
.vscode/
*.iml
.DS_Store

# Uploads & Logs
uploads/
*.log

# Env / Secrets
.env
.env.*
!.env.example

# 블루/그린 활성 슬롯 기록. EC2 호스트마다 값이 다르므로 커밋하지 않는다.
# (CD 가 EC2 에서 git reset --hard 를 하므로 추적 대상이 되면 배포 때마다 날아간다)
.deploy-state

# Compiled class file
*.class
*.war

# jar 은 원칙적으로 제외하되, Gradle Wrapper jar 은 반드시 커밋해야 한다.
*.jar
!backend/gradle/wrapper/gradle-wrapper.jar
