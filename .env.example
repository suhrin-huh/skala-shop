# SKALA-FUND 환경변수 템플릿
#
# 이 파일은 "키 이름만" 담는다. 실제 값을 여기에 적지 않는다.
#   cp .env.example .env   후 값을 채운다. .env 는 .gitignore 에 걸려 있다.
#
# docker-compose.yml 의 backend 서비스가 이 .env 를 env_file 로 읽는다.
# DB 는 H2 인메모리(dev 프로파일)라 별도 DB 환경변수가 필요 없다.

# ---------------------------------------------------------------------------
# 인증
# ---------------------------------------------------------------------------
# HS256 서명 키. 최소 256bit 의 Base64 문자열이어야 한다.
#   openssl rand -base64 48
# application.yml 의 개발용 키를 그대로 쓰면 안 된다. 그 값은 저장소에 공개돼 있다.
JWT_SECRET=

# ---------------------------------------------------------------------------
# AWS (S3 이미지 저장)
# ---------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
