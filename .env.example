# SKALA-FUND 환경변수 템플릿 (INF-06)
#
# 이 파일은 "키 이름만" 담는다. 실제 값을 여기에 적지 않는다.
# EC2 에서:  cp .env.example .env  후 값을 채운다. .env 는 .gitignore 에 걸려 있다.
#
#   chmod 600 .env      # 같은 호스트의 다른 사용자가 읽지 못하게 한다
#
# 같은 값을 GitHub Actions Secrets 에도 등록해야 CD 가 동작한다.
# 체크리스트는 docs/infrastructure.md 를 참고한다.

# ---------------------------------------------------------------------------
# 컨테이너 이미지 (ECR)
# ---------------------------------------------------------------------------
# 예: 123456789012.dkr.ecr.ap-northeast-2.amazonaws.com
ECR_REGISTRY=
BACKEND_REPOSITORY=skala-fund-backend
FRONTEND_REPOSITORY=skala-fund-frontend
# CD 가 커밋 SHA 로 덮어쓴다. 수동 배포 시에만 직접 지정한다.
# 백엔드와 프론트는 배포 시점이 다르므로 태그를 따로 관리한다.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest

# ---------------------------------------------------------------------------
# 데이터베이스 (RDS MySQL 8)
# ---------------------------------------------------------------------------
# RDS 엔드포인트. 예: skala-fund.xxxxxx.ap-northeast-2.rds.amazonaws.com
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# 인증
# ---------------------------------------------------------------------------
# HS256 서명 키. 최소 256bit 의 Base64 문자열이어야 한다.
#   openssl rand -base64 48
# application.yml 의 개발용 키를 그대로 쓰면 안 된다. 그 값은 저장소에 공개돼 있다.
JWT_SECRET=

# ---------------------------------------------------------------------------
# AWS (S3 이미지 저장)
# ---------------------------------------------------------------------------
AWS_REGION=ap-northeast-2
# EC2 에 IAM 인스턴스 프로파일을 붙였다면 아래 두 개는 비워 둔다.
# 장기 액세스 키를 파일에 두는 것보다 인스턴스 프로파일이 안전하다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
